{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores user profile information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "description": "URL to user's profile photo." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User's role in the system." }
      },
      "required": ["uid", "email"]
    },
    "resources": {
      "title": "Resource",
      "description": "Represents a document or form resource.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "Title of the resource." },
        "url": { "type": "string", "description": "URL to the resource (e.g. Google Drive link)." },
        "type": { "type": "string", "enum": ["document", "form"], "description": "Type of resource." },
        "method": { "type": "string", "enum": ["link", "file"], "description": "Upload method (direct file or URL link)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "url", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile documents."
    },
    "/resources/{resourceId}": {
      "schema": "resources",
      "description": "Documents and forms resources."
    }
  }
}
